{
  "EnableTiming": true,
  "ModuleSequence": [
    "Generator",
    "GeantSim",
    "TrackTruncator",
    "Track3DBuilder",
    "EventFileExporter"
  ],
  "GeometryConfig": "@CMAKE_INSTALL_PREFIX@/resources/geometry_ELITPC_190mbar_3332Vdrift_25MHz.dat",
  "ModuleConfiguration": {
    "Generator": {
      "NumberOfEvents": 10000,
      "Verbosity": 1,
      "EventGenerator": {
        "Beam": {
          "BeamGeometry": {
            "EulerAnglesNominal": {
              "phi": "-M_PI/2",
              "theta": "M_PI/2",
              "psi": 0.0
            },
            "EulerAnglesActual": {
              "phi": 0.0,
              "theta": 0.0,
              "psi": 0.0
            },
            "BeamPosition": {
              "x": 0,
              "y": 0,
              "z": 0
            }
          },
          "GammaEnergy": {
            "distribution": "EProviderSingle",
            "parameters": {
              "singleE": 0
            }
          }
        },
        "Vertex": {
          "VertexTransverse": {
            "distribution": "XYProviderSingle",
            "parameters": {
              "singleX": 0,
              "singleY": 0
            }
          },
          "VertexLongitudinal": {
            "distribution": "ZProviderSingle",
            "parameters": {
              "singleZ": 0
            }
          }
        },
        "Reactions": [
          {
            "type": "ParticleGun",
            "branchingRatio": 1,
            "tag": "PARTICLE_GUN",
            "Particle": "ALPHA",
            "Theta": {
              "distribution": "AngleProviderSingle",
              "parameters": {
                "singleAngle": "-M_PI"
              }
            },
            "Phi": {
              "distribution": "AngleProviderSingle",
              "parameters": {
                "singleAngle": 0
              }
            },
            "KineticEnergy": {
              "distribution": "EProviderSingle",
              "parameters": {
                "singleE": 3
              }
            }
          }
        ]
      }
    },
    "EventFileExporter": {
      "FileName": "SimEvent_Track3D_SingleAlpha_MC.root",
      "EnabledBranches": [
        "SimEvent",
        "### UNCOMMENT TO ENABLE BRANCH ### PEventTPC",
        "Track3D"
      ],
      "DisabledBranches": [
        "TPCData.myChargeArray*",
        "### UNCOMMENT TO DISABLE BRANCH ### TPCData.myChargeMap",
        "### UNCOMMENT TO DISABLE BRANCH ### TPCData.tracks.hits",
        "### UNCOMMENT TO DISABLE BRANCH ### TPCRecoData.mySegments.myRecHits"
      ]
    },
    "GeantSim": {
      "EnableAlphaStraggling": true,	  
      "Temperature": 293.15,
      "gas_mixture": {
        "co2": 0.19,
        "he": 0.0
      },
      "magnetic_field": {
        "magnetic_field_ON": false,
        "magnetic_field_map": "",
        "magnetic_field_offset": 200
      },
      "GeometryConfig": {
        "ModelPath": "@CMAKE_INSTALL_PREFIX@/MonteCarlo/Modules/Geant_STL_model/",
        "MaterialColors": {
          "aluminium": {
            "r": 132,
            "g": 135,
            "b": 137,
            "alpha": 1
          },
          "peek": {
            "r": 222,
            "g": 184,
            "b": 135,
            "alpha": 1
          },
          "kapton": {
            "r": 236,
            "g": 206,
            "b": 106,
            "alpha": 1
          },
          "copper": {
            "r": 184,
            "g": 115,
            "b": 51,
            "alpha": 1
          },
          "stainless": {
            "r": 132,
            "g": 135,
            "b": 137,
            "alpha": 0.2
          },
          "FR4": {
            "r": 4,
            "g": 179,
            "b": 109,
            "alpha": 1
          }
        },
        "Solids": {
          "kapton": [
            "*gem_kapton*",
            "*ISO_KF40_window_kapton*"
          ],
          "stainless": [
            "*drift_conn*",
            "*M2*",
            "*pcb_compression_plate*",
            "*vessel_collar*",
            "*vessel_barrel_wall*",
            "*ISO_KF40_weld_flange*",
            "*vessel_endcap1*",
            "*vessel_endcap2*",
            "*ISO_KF40_full_nipple_130mm*",
            "*ISO_KF40_window_flange_35mm*",
            "ISO_KF40_centering_ring_modified*",
            "*PFEIFFER_170SFK040-06"
          ],
          "copper": [
            "*gem_cu_layer1*",
            "*gem_cu_layer2*",
            "*pcb_gnd_top*",
            "*pcb_gnd_bottom*"
          ],
          "aluminium": [
            "*drift_strip1*",
            "*drift_strip2*",
            "*cathode_plate*",
            "*ISO_KF40_clamp*"
          ],
          "peek": [
            "*gem_frame*",
            "*drift_rod*",
            "*drift_screw*",
            "*drift_spacer*",
            "*drift_spacer2*",
            "*drift_frame1*",
            "*drift_frame2*"
          ],
          "FR4":[
            "*pcb_readout_core*"
          ]
        }
      }
    },
    "TPCDigitizerRandom": {
      "sigmaXYmin": 1.5,
      "sigmaXYmax": 1.5,
      "sigmaZmin": 1.5,
      "sigmaZmax": 1.5,
      "NSamplesPerHit": 100,
      "MeVToChargeScale": 100000
    },
    "TPCDigitizerSRC": {
      "StripResponsePath": "@CMAKE_INSTALL_PREFIX@/MonteCarlo/Modules/StripResponseModel/",
      "sigmaXY": 1.5,
      "sigmaZ": 1.5,
      "MeVToChargeScale": 100000,
      "th2PolyPartitionX": 60,
      "th2PolyPartitionY": 40,
      "peakingTime": 232,
      "nStrips": 7,
      "nCells": 50,
      "nPads": 14
    },
    "Track3DBuilder": {
      "simRecoHitFilter": {
        "recoClusterType": "fraction",
        "recoClusterThreshold": 35.0,
        "recoClusterConstantFractionThreshold": 0.1,
        "recoClusterDeltaStrips": 2,
        "recoClusterDeltaTimeCells": 5
      }
    },
    "TrackTruncator": {
      "IncludeElectronicsRange": true
    },
    "TriggerSimulator": {
      "TriggerArrival": 0.1
    },
    "ToyIonizationSimulator": {
      "Temperature": 293.15,
      "Pressure": 0.19,
      "PointsPerMm": 10.0
    }
  }
}
